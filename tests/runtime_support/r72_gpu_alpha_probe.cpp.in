int main() {
 using namespace cth3ds;assert(SDL_Init(0)==0);assert(gpu_initialize());
 auto* out=SDL_CreateRGBSurfaceWithFormat(0,640,480,32,SDL_PIXELFORMAT_ABGR8888);
 auto* renderer=SDL_CreateSoftwareRenderer(out);assert(renderer);render_target target{renderer,out};
 std::vector<u32> pattern(32*32);for(int y=0;y<32;++y)for(int x=0;x<32;++x)pattern[y*32+x]=0xff000000U|u32(x*7)|u32(y*5)<<8U|u32((x+y)*3)<<16U;
 std::vector<u32> original;unsigned queued_batches=0;
 for(int variant=0;variant<2;++variant) {
  auto* texture=gpu_image_create(renderer,32,32,pattern.data());assert(texture);
  assert(gpu_begin());assert(gpu_clear(0xff102030U));
  const auto waits_before=waits;const auto draws_before=render_work.draws;const auto flips_before=render_work.flipped_fallback;
  // Keep all calls pending; the same handle is recoloured between commands.
  for(int i=0;i<32;++i) {
   int flags=((i%4)==0?0:(i%4)==1?4:(i%4)==2?8:12)|(i/4%4);
   SDL_Rect cut{10+i%3,9+i%5,60,60};gpu_clip(&cut);
   SDL_Rect dst{8+i%7,7+i%11,32,32};
   if(variant)target.draw(texture,nullptr,&dst,flags);else target.reference_draw(texture,nullptr,&dst,flags);
   assert(in_frame&&pending.empty()&&!commands.empty());assert(waits==waits_before);
  }
  assert(render_work.draws-draws_before==32);assert(render_work.flipped_fallback-flips_before==24);
