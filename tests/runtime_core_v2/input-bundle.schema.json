{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corsixth.example.invalid/schemas/verifier-input-bundle-v1.json",
  "title": "CorsixTH verifier input bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_id",
    "created_at_utc",
    "root_rule",
    "candidate_identity",
    "validation_change_authority",
    "inputs",
    "immutability",
    "lifecycle"
  ],
  "properties": {
    "schema": {
      "const": "cth3ds.verifier-input-bundle/v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "root_rule": {
      "const": "consumer paths resolve beneath bundle_root; provenance paths are audit metadata only"
    },
    "candidate_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "tree", "parents", "tracked_entries", "tracked_fingerprint"],
      "properties": {
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "parents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        },
        "tracked_entries": {"type": "integer", "minimum": 1},
        "tracked_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "validation_change_authority": {
      "$ref": "#/$defs/authority_projection"
    },
    "inputs": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/input"}
    },
    "immutability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_mode", "directory_mode", "symlink_policy", "stage_rehash"],
      "properties": {
        "file_mode": {"const": "0444"},
        "directory_mode": {"const": "0555"},
        "symlink_policy": {"const": "internal-relative-only"},
        "stage_rehash": {"const": true}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "ends_after", "outputs_separate"],
      "properties": {
        "owner": {"const": "validation-task"},
        "ends_after": {"const": "durable-final-receipt-accepted"},
        "outputs_separate": {"const": true}
      }
    }
  },
  "$defs": {
    "authority_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "dag_input_role",
        "dag_input_sha256",
        "dag_authority_json_pointer",
        "authority_canonical_sha256",
        "authorized_diff_count",
        "authorized_diff_lines_sha256",
        "authorized_diff_exact",
        "projection"
      ],
      "properties": {
        "schema": {"const": "cth3ds.validation-authority-projection/v1"},
        "dag_input_role": {"const": "execution_dag"},
        "dag_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dag_authority_json_pointer": {"type": "string", "pattern": "^/[^/]+$"},
        "authority_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authorized_diff_count": {"type": "integer", "minimum": 1},
        "authorized_diff_lines_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authorized_diff_exact": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "uniqueItems": true
        },
        "projection": {"$ref": "#/$defs/validation_authority"}
      }
    },
    "validation_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "owner",
        "baseline",
        "authorized_diff_count",
        "authorized_diff_lines_sha256",
        "authorized_diff_exact",
        "review_policy_schema_role",
        "product_boundary",
        "candidate_constraints"
      ],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "tree"],
          "properties": {
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "authorized_diff_count": {"type": "integer", "minimum": 1},
        "authorized_diff_lines_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authorized_diff_exact": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "uniqueItems": true
        },
        "review_policy_schema_role": {
          "type": "object",
          "additionalProperties": false,
          "required": ["json_pointer", "required_keywords", "forbidden_keywords"],
          "properties": {
            "json_pointer": {"type": "string", "pattern": "^/"},
            "required_keywords": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "forbidden_keywords": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "product_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry_count", "sha256"],
          "properties": {
            "entry_count": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "candidate_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sole_parent", "clean", "repair_commits"],
          "properties": {
            "sole_parent": {"type": "boolean"},
            "clean": {"type": "boolean"},
            "repair_commits": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "owner",
        "provenance_source_path",
        "bundle_relative_path",
        "kind",
        "byte_size_or_tree_entry_count",
        "sha256_or_tree_digest",
        "required_stages",
        "copied_at_utc",
        "mode",
        "symlink_policy",
        "source_identity",
        "lifecycle_end",
        "cleanup_boundary"
      ],
      "properties": {
        "role": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "owner": {"type": "string", "minLength": 1},
        "provenance_source_path": {"type": "string", "minLength": 1},
        "bundle_relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "kind": {"enum": ["file", "tree"]},
        "byte_size_or_tree_entry_count": {"type": "integer", "minimum": 0},
        "sha256_or_tree_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "required_stages": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "copied_at_utc": {"type": "string", "format": "date-time"},
        "mode": {"enum": ["0444", "0555-tree"]},
        "symlink_policy": {"const": "internal-relative-only"},
        "source_identity": {"type": "object"},
        "lifecycle_end": {"type": "string", "minLength": 1},
        "cleanup_boundary": {"type": "string", "minLength": 1}
      }
    }
  }
}
