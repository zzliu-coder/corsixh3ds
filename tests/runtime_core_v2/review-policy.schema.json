{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corsixth.example/schemas/runtime-core-review-policy-v6.json",
  "$defs": {
    "lstat_closure": {
      "type": "object",
      "required": ["algorithm", "root_realpath", "node_count", "nodes", "sha256"],
      "properties": {
        "algorithm": {"const": "lstat-tree-v1"},
        "root_realpath": {"type": "string", "pattern": "^/"},
        "node_count": {"type": "integer", "minimum": 1},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"type": "object", "required": ["path", "type", "mode"], "properties": {"path": {"type": "string"}, "type": {"const": "directory"}, "mode": {"type": "string"}}, "additionalProperties": false},
              {"type": "object", "required": ["path", "type", "mode", "bytes", "sha256"], "properties": {"path": {"type": "string"}, "type": {"const": "regular"}, "mode": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
              {"type": "object", "required": ["path", "type", "mode", "target", "resolved_path"], "properties": {"path": {"type": "string"}, "type": {"const": "symlink"}, "mode": {"type": "string"}, "target": {"type": "string"}, "resolved_path": {"type": "string"}}, "additionalProperties": false}
            ]
          }
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "validation_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "owner",
        "baseline",
        "authorized_diff_count",
        "authorized_diff_lines_sha256",
        "authorized_diff_exact",
        "review_policy_schema_role",
        "product_boundary",
        "candidate_constraints"
      ],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "tree"],
          "properties": {
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "authorized_diff_count": {"type": "integer", "minimum": 1},
        "authorized_diff_lines_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authorized_diff_exact": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "uniqueItems": true
        },
        "review_policy_schema_role": {
          "type": "object",
          "additionalProperties": false,
          "required": ["json_pointer", "required_keywords", "forbidden_keywords"],
          "properties": {
            "json_pointer": {"type": "string", "pattern": "^/"},
            "required_keywords": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "forbidden_keywords": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "product_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry_count", "sha256"],
          "properties": {
            "entry_count": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "candidate_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sole_parent", "clean", "repair_commits"],
          "properties": {
            "sole_parent": {"type": "boolean"},
            "clean": {"type": "boolean"},
            "repair_commits": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "schema",
    "stage_id",
    "policy_id",
    "created_at",
    "verified_invocation",
    "verified_invocation_sha256",
    "base_identity",
    "candidate_identity",
    "validation_change_authority",
    "product_boundary",
    "roots",
    "role_registry",
    "environment_profiles",
    "commands",
    "gate_oracles",
    "rh10_provenance",
    "upstream_source",
    "closure_inputs",
    "host_regression",
    "simulator_semantic_baseline",
    "tool_implementation_identity",
    "xbuild_input_closures",
    "fresh_chain",
    "acceptance_inputs",
    "limits"
  ],
  "properties": {
    "schema": {
      "const": "cth3ds.runtime-core-review-policy/v6"
    },
    "stage_id": {
      "const": "C3-R5"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^c3-[0-9a-f]{32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_invocation": {
      "type": "object"
    },
    "verified_invocation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_identity": {
      "type": "object",
      "required": [
        "commit",
        "tree",
        "parent",
        "tracked_fingerprint_v3",
        "tracked_entries"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "parent": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tracked_fingerprint_v3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tracked_entries": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "candidate_identity": {
      "type": "object",
      "required": [
        "required_first_parent",
        "forbidden_ancestors",
        "expected_commit",
        "expected_tree",
        "expected_candidate_fingerprint",
        "expected_candidate_entries",
        "require_clean",
        "ancestry"
      ],
      "properties": {
        "required_first_parent": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "forbidden_ancestors": {
          "type": "array",
          "prefixItems": [
            {
              "const": "0637cc8d64a3152ae27bee344806ae9aec58592b"
            },
            {
              "const": "9ff2b84114df9070d578c88fe927255369c12b6d"
            },
            {
              "const": "4b3bea525923a9ba6199c7b08f36aa814863f4e4"
            },
            {
              "const": "7f637a26a966e470cb250d9dba6ec55a7e834ace"
            },
            {
              "const": "161fa9cbff67138aca6b1c7d22eada7293f70fac"
            },
            {
              "const": "ff919031256fd057d87d6bb8126a076164588478"
            }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true
        },
        "expected_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "expected_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "expected_candidate_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_candidate_entries": {
          "type": "integer",
          "minimum": 192
        },
        "require_clean": {
          "const": true
        },
        "ancestry": {
          "type": "object",
          "required": ["algorithm", "object_format", "head", "head_tree", "head_parents", "first_parent_chain", "roots", "commit_count", "edge_count", "commits", "forbidden_intersection", "closure_sha256"],
          "properties": {
            "algorithm": {"const": "raw-full-parent-closure-v1"},
            "object_format": {"const": "sha1"},
            "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "head_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "head_parents": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "minItems": 1, "maxItems": 1},
            "first_parent_chain": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "minItems": 2, "uniqueItems": true},
            "roots": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "minItems": 1, "uniqueItems": true},
            "commit_count": {"type": "integer", "minimum": 2},
            "edge_count": {"type": "integer", "minimum": 1},
            "commits": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["oid", "tree", "parents", "raw_sha256"], "properties": {"oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "parents": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}, "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}},
            "forbidden_intersection": {"const": []},
            "closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "validation_change_authority": {
      "$ref": "#/$defs/validation_authority"
    },
    "product_boundary": {
      "type": "object",
      "required": [
        "fingerprint_algorithm",
        "product_exact",
        "product_prefixes",
        "expected_product_fingerprint",
        "expected_product_entries",
        "allowlist_exact",
        "forbidden_patterns",
        "require_product_diff_empty"
      ],
      "properties": {
        "fingerprint_algorithm": {
          "const": "v3-mode-type-path-payload-sha256-nul"
        },
        "product_exact": {
          "type": "array",
          "prefixItems": [
            {
              "const": "tools/th3ds_convert.py"
            },
            {
              "const": "scripts/build_3ds.sh"
            },
            {
              "const": "scripts/bootstrap_upstream.sh"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "product_prefixes": {
          "type": "array",
          "prefixItems": [
            {
              "const": "cmake/"
            },
            {
              "const": "include/"
            },
            {
              "const": "src/"
            },
            {
              "const": "lua/"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "expected_product_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expected_product_entries": {
          "const": 54
        },
        "allowlist_exact": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "uniqueItems": true
        },
        "forbidden_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "require_product_diff_empty": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "root_id",
          "class",
          "absolute_realpath",
          "node_type",
          "access",
          "allowed_kinds"
        ],
        "properties": {
          "root_id": {
            "type": "string"
          },
          "class": {
            "enum": [
              "candidate",
              "evidence_raw",
              "build",
              "source",
              "reviewer_bundle",
              "seal"
            ]
          },
          "absolute_realpath": {
            "type": "string",
            "pattern": "^/(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[~$*?\\[\\]])[^\\u0000]+$"
          },
          "node_type": {
            "const": "directory"
          },
          "access": {
            "enum": [
              "readonly",
              "producer_write_then_freeze",
              "consumer_write_once"
            ]
          },
          "allowed_kinds": {
            "type": "array",
            "items": {
              "enum": [
                "build",
                "tool",
                "artifact",
                "fixture",
                "invocation",
                "closure_input",
                "source_file",
                "seal_output"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true
    },
    "role_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "role",
          "count",
          "allowed_root_ids",
          "node_type",
          "media_type",
          "required_owner_kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "build",
              "tool",
              "artifact",
              "fixture",
              "invocation",
              "closure_input"
            ]
          },
          "role": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "allowed_root_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "node_type": {
            "enum": [
              "regular_file",
              "directory",
              "process_record"
            ]
          },
          "media_type": {
            "type": "string"
          },
          "required_owner_kind": {
            "enum": [
              "invocation",
              "fixture",
              "policy",
              "none"
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 115,
      "maxItems": 115,
      "uniqueItems": true
    },
    "environment_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "clear_environment",
          "variables",
          "unset_variables",
          "locale"
        ],
        "properties": {
          "profile_id": {
            "type": "string"
          },
          "clear_environment": {
            "const": true
          },
          "variables": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "unset_variables": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "locale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command_id",
          "role",
          "gate_id",
          "executable_kind",
          "executable_role",
          "argv",
          "cwd_root_id",
          "environment_profile_id",
          "timeout_seconds",
          "stdout_role",
          "stderr_role",
          "output_roles"
        ],
        "properties": {
          "command_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "gate_id": {
            "type": "string"
          },
          "executable_kind": {
            "enum": [
              "tool",
              "artifact"
            ]
          },
          "executable_role": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "cwd_root_id": {
            "type": "string"
          },
          "environment_profile_id": {
            "type": "string"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "stdout_role": {
            "type": "string"
          },
          "stderr_role": {
            "type": "string"
          },
          "output_roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "minItems": 19,
      "maxItems": 19,
      "uniqueItems": true
    },
    "gate_oracles": {
      "type": "object",
      "required": [
        "pool_order",
        "backend_order",
        "stable_states",
        "h1",
        "h2"
      ],
      "properties": {
        "pool_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true
        },
        "backend_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "stable_states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "h1": {
          "type": "object",
          "required": [
            "oracle_id",
            "failure_code"
          ],
          "properties": {
            "oracle_id": {
              "const": "H1_LEVEL_REQUIRES_DECLARED_PACKAGE"
            },
            "failure_code": {
              "const": "H1_LEVEL_NOT_DECLARED_ACCEPTED"
            }
          },
          "additionalProperties": false
        },
        "h2": {
          "type": "object",
          "required": [
            "oracle_id",
            "failure_code"
          ],
          "properties": {
            "oracle_id": {
              "const": "H2_TRANSITION_CAPABILITY_ROLLBACK"
            },
            "failure_code": {
              "const": "H2_ESCAPED_CAPABILITY_PUBLISHED_STABLE"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "rh10_provenance": {
      "type": "object",
      "required": [
        "fixture_role",
        "payload_origin",
        "contains_original_theme_hospital_data",
        "container_schema_claim",
        "container_claim_scope"
      ],
      "properties": {
        "fixture_role": {
          "const": "no-level-synthetic"
        },
        "payload_origin": {
          "const": "generated_synthetic"
        },
        "contains_original_theme_hospital_data": {
          "const": false
        },
        "container_schema_claim": {
          "type": "object",
          "required": [
            "contains_user_game_data",
            "redistributable"
          ],
          "properties": {
            "contains_user_game_data": {
              "const": true
            },
            "redistributable": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "container_claim_scope": {
          "const": "TH3DSR1_container_safety_classification"
        }
      },
      "additionalProperties": false
    },
    "upstream_source": {
      "type": "object",
      "required": [
        "archive_artifact_id",
        "archive_root_id",
        "archive_relative_path",
        "archive_bytes",
        "archive_sha256",
        "archive_top_directory",
        "snapshot_root_id",
        "upstream_tree_manifest_artifact_id",
        "upstream_expected_file_count",
        "upstream_expected_tree_digest",
        "integrated_root_id",
        "integrated_tree_manifest_artifact_id",
        "integrated_expected_file_count",
        "integrated_expected_tree_digest",
        "overlay_mapping",
        "tree_digest_algorithm"
      ],
      "properties": {
        "archive_artifact_id": {
          "const": "a-xbuild-upstream-snapshot-archive"
        },
        "archive_root_id": {
          "const": "reviewer_bundle"
        },
        "archive_relative_path": {
          "type": "string"
        },
        "archive_bytes": {
          "const": 4416083
        },
        "archive_sha256": {
          "const": "e1bc438183bbc95e40edf9363628cb73897559c01f537cdce42638e5bb2076f8"
        },
        "archive_top_directory": {
          "const": "CorsixTH-56bd5d00f76331c7f76d7b696726a7926303ca0c/"
        },
        "snapshot_root_id": {
          "const": "source_upstream_snapshot"
        },
        "upstream_tree_manifest_artifact_id": {
          "const": "a-xbuild-upstream-source-tree-manifest"
        },
        "upstream_expected_file_count": {
          "const": 644
        },
        "upstream_expected_tree_digest": {
          "const": "e8622007fa508f3471294e5954ebc83168d95c81beb3b09b797bf65c02bf1801"
        },
        "integrated_root_id": {
          "const": "source_xbuild_integrated"
        },
        "integrated_tree_manifest_artifact_id": {
          "const": "a-xbuild-integrated-source-tree-manifest"
        },
        "integrated_expected_file_count": {
          "type": "integer",
          "minimum": 644
        },
        "integrated_expected_tree_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "overlay_mapping": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "candidate_path",
              "candidate_blob",
              "integrated_path",
              "mode"
            ],
            "properties": {
              "candidate_path": {
                "type": "string"
              },
              "candidate_blob": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "integrated_path": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "100644",
                  "100755"
                ]
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "tree_digest_algorithm": {
          "const": "source-tree-v1"
        }
      },
      "additionalProperties": false
    },
    "closure_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "closure_input_id",
          "role",
          "root_id",
          "relative_path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "closure_input_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "root_id": {
            "const": "candidate"
          },
          "relative_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\\\\\)[^\\u0000]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true
    },
    "host_regression": {
      "type": "object",
      "required": ["unexpected_skipped", "allowed_skip_reason_prefixes", "runner_path", "runner_sha256", "manifest_path", "manifest_sha256", "baseline_count", "baseline_sorted_ids_sha256", "selected_count", "selected_sorted_ids_sha256", "interpreter_executable", "interpreter_version", "interpreter_implementation_sha256"],
      "properties": {
        "unexpected_skipped": {"const": 0},
        "allowed_skip_reason_prefixes": {
