  for(int i=0;i<4;++i) {
   SDL_Rect dst{120+i*40,100,32,32};int flags=i==0?0:i==1?4:i==2?8:12;
   if(variant)target.draw(sentinel,nullptr,&dst,flags);else target.reference_draw(sentinel,nullptr,&dst,flags);
  }
