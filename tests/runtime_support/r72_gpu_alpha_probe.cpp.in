const float frect_overdraw=.01F;
struct render_target {
 SDL_Renderer* renderer; SDL_Surface* game_surface;
 struct Scope { SDL_Rect rect; bool scale; void offset(SDL_FRect& r) {r.x-=float(rect.x);r.y-=float(rect.y);} };
 Scope* current_target=nullptr; double global_scale_factor=1.;
 double draw_scale() {return current_target&&!current_target->scale?1.:global_scale_factor;}
 void draw(SDL_Texture*,const SDL_Rect*,const SDL_Rect*,int);
 void reference_draw(SDL_Texture*,const SDL_Rect*,const SDL_Rect*,int);
